      "name": "Embed Search Query"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT title, content, category, embedding <=> $1::vector AS distance\nFROM kb_documents\nWHERE embedding <=> $1::vector < 0.8\nORDER BY distance ASC\nLIMIT 3;",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json.data[0].embedding) }}"
        }
      },
