      "name": "Receive Search Query",
      "alwaysOutputData": false
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst realMatches = items.filter(item => item.json.content);\n\nif (realMatches.length === 0) {\n  return [\n    {\n      json: {\n        result: \"No matching policy documents found for this query.\"\n      }\n    }\n  ];\n}\n\nconst summary = realMatches\n  .map(item => `${item.json.title}: ${item.json.content}`)\n  .join(\"\\n\\n\");\n\nreturn [\n  {\n    json: {\n      result: summary\n    }\n  }\n];"
      },
