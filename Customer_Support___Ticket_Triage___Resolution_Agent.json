    {
      "parameters": {
        "jsCode": "const ticketId = $('Upsert Ticket Record').item.json.id;\nconst externalId = $('Upsert Ticket Record').item.json.external_id;\nconst subject = $('Upsert Ticket Record').item.json.subject;\nconst customerEmail = $('Upsert Ticket Record').item.json.customer_email;\nconst customerMessage = $('Upsert Ticket Record').item.json.body;\nconst draftReply = $json.full_reply || \"(No reply was generated.)\";\nconst actions = $json.actions || [];\n\nfunction summarizeAction(action) {\n  if (action.tool_called === \"search_policy_docs\") {\n    return `Searched the knowledge base → ${JSON.stringify(action.output)}`;\n  }\n  if (action.tool_called === \"lookup_order_status\") {\n    return `Looked up an order → ${JSON.stringify(action.output)}`;\n  }\n  return `Called ${action.tool_called} → ${JSON.stringify(action.output)}`;\n}\n\nlet historyText = \"No tools were called before this ticket was escalated.\";\nif (actions.length > 0) {\n  historyText = actions.map(a => `• ${summarizeAction(a)}`).join(\"\\n\");\n}\n\nconst message = `🚨 *Action needed: please review this ticket*\n\nThis ticket could not be fully confirmed as resolved by the AI agent. A reply has \nalready been sent to the customer — please review it below and follow up directly \nif it looks incomplete, incorrect, or if this customer needs further attention.\n\n*Ticket:* ${externalId} (internal ID: ${ticketId})\n*Customer:* ${customerEmail}\n*Subject:* ${subject}\n\n*Customer's message:*\n${customerMessage}\n\n*What the Agent already sent the customer:*\n${draftReply}\n\n*What the Agent checked before responding:*\n${historyText}`;\n\nreturn [{ json: { slack_message: message } }];"
      },
