    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst agentOutput = items[0].json;\nconst steps = agentOutput.intermediateSteps || [];\n\nif (steps.length === 0) {\n  return [];\n}\n\nfunction toJsonbValue(value) {\n  let parsed = value;\n\n  if (typeof value === \"string\") {\n    try {\n      parsed = JSON.parse(value);\n    } catch (e) {\n      parsed = { text: value };\n    }\n  }\n\n  if (Array.isArray(parsed)) {\n    return { items: parsed };\n  }\n\n  if (typeof parsed !== \"object\" || parsed === null) {\n    return { value: parsed };\n  }\n\n  return parsed;\n}\n\nreturn steps.map(step => {\n  return {\n    json: {\n      tool_called: step.action.tool,\n      input: toJsonbValue(step.action.toolInput),\n      output: toJsonbValue(step.observation)\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
